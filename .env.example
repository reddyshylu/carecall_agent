# Copy this file to .env and paste your own keys. Never commit .env.
# Nebius Token Factory (required for the model path; without it the agent runs its fixed plan)
NEBIUS_API_KEY=replace_locally
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_PRICE_IN_PER_M=0.10
NEBIUS_PRICE_OUT_PER_M=0.30
# Optional: reuse the Week 2 Pinecone index (namespace carecall-200-v1) for hybrid chart search
PINECONE_API_KEY=replace_locally
PINECONE_INDEX=patient-chart-bge
# ElevenLabs voice caller (browser calls, no phone line). Run scripts/create_voice_agent.py once;
# it saves CARECALL_VOICE_AGENT_ID here.
ELEVENLABS_API_KEY=replace_locally
ELEVENLABS_VOICE_ID=replace_locally
CARECALL_VOICE_AGENT_ID=replace_after_create
